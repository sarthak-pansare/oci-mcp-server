# Normalize text files to LF in the repo. Lets CI run identically on Linux/macOS/Windows.
* text=auto eol=lf

# Always LF (executed by shells / parsed by interpreters)
*.sh   text eol=lf
*.py   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.json text eol=lf
Dockerfile text eol=lf

# Binaries
*.png binary
*.jpg binary
*.gif binary
*.pem binary
*.key binary
